{
  "name": "bridge-deal",
  "version": "0.0.0",
  "decription": "Deal bridge hands randomly, according to a recipe",
  "main": "index.js",
  "type": "module",
  "private": "true",
  "scripts": {
    "build": "peggy src/deal.peggy --format es && tsc",
    "postbuild": "copyfiles -u -a -f src/deal.js docs/js",
    "lint": "eslint .",
    "start": "hostlocal",
    "test": "c8 node --test",
    "update": "UPDATE_SNAPSHOT=1 npm test",
    "ci": "npm run build && npm run lint && npm run test"
  },
  "keywords": [
    "bridge",
    "deal",
    "dealer",
    "hand",
    "cards",
    "trick",
    "cardgame",
    "random"
  ],
  "author": "Joe Hildebrand <joe-github@cursive.net>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hildjj/bridge-deal.git"
  },
  "homepage": "https://github.com/hildjj/bridge-deal#readme",
  "bugs": {
    "url": "https://github.com/hildjj/bridge-deal/issues"
  },
  "devDependencies": {
    "@cto.af/eslint-config": "^6.2.5",
    "@eslint/markdown": "^7.5.1",
    "@peggyjs/coverage": "^2.0.5",
    "copyfiles": "^2.4.1",
    "eslint": "^10.1.0",
    "eslint-plugin-jsdoc": "^62.8.0",
    "hostlocal": "^2.4.1",
    "peggy": "^5.1.0",
    "snappy-snaps": "^1.1.0",
    "superc8": "^12.3.1",
    "typescript": "^5.4.2",
    "typescript-eslint": "^8.57.1"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "overrides": {
      "snappy-snaps@1.1.0>serialize-javascript": "7.0.4"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
